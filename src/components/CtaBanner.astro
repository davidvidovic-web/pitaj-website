<section class="reveal-on-scroll w-full bg-white">
  <div class="mx-auto max-w-[1240px] px-6 py-20 text-center lg:border-x border-[#e4e4e7] lg:px-16 lg:py-28">
    <div class="max-w-[780px] mx-auto">
      <h2 class="text-balance text-[2.25rem] font-medium leading-[1.12] tracking-[-0.03em] text-[#09090b] sm:text-[2.75rem] lg:text-[3.25rem]">
        Najbolja <span class="font-proza italic font-normal">korisnička iskustva</span> pokreće Pitaj.io
      </h2>
      <p class="mt-6 text-[16px] leading-relaxed text-[#71717a] sm:text-[18px]">
        Pridružite se hiljadama timova koji koriste Pitaj.io za kreiranje AI agenata koji pružaju vrhunsku podršku u svakom trenutku — putem chata, e-maila i glasa.
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3.5 sm:flex-row">
        <a
          href="https://app.pitaj.io/auth/register"
          class="flex h-11 w-full sm:w-auto items-center justify-center rounded-full bg-black px-7 text-[14px] font-medium text-white shadow-sm transition-all hover:bg-neutral-800 active:scale-[0.98]"
        >
          Kreirajte agenta
        </a>
        <a
          href="/za-firme"
          class="flex h-11 w-full sm:w-auto items-center justify-center rounded-full border border-[#e4e4e7] bg-white px-7 text-[14px] font-medium text-[#09090b] shadow-xs transition-all hover:bg-[#fafafa] active:scale-[0.98]"
        >
          Zakažite demo
        </a>
      </div>
    </div>
  </div>
</section>
