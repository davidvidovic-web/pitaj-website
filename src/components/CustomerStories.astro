---
const stories = [
  {
    quote: "Pacijenti nas stalno zovu i pišu van radnog vremena. Pitaj agent odgovara na pitanja o uslugama, pripremi za pregled i cijenama, pa ujutro imamo zabilježene upite bez ijednog propuštenog pacijenta.",
    author: "Dr. Goran Simić",
    role: "Stomatološka poliklinika",
    metric: "80% upita van radnog vremena",
    badge: "Zdravstvo & Klinike",
    href: "/klijenti"
  },
  {
    quote: "Povezali smo WooCommerce trgovinu u samo par minuta. Kupci više ne čekaju operatera da saznaju gdje im je paket ili ima li njihova veličina — agent provjeri zalihe i odmah vodi do kupovine.",
    author: "Damir Kovačević",
    role: "Voditelj e-trgovine",
    metric: "4.9/5 zadovoljstvo kupaca",
    badge: "Web Trgovina",
    href: "/klijenti"
  },
  {
    quote: "Gosti postavljaju pitanja o parkingu, doručku i check-inu u svako doba dana i noći. Pitaj agent odgovara trenutno i tečno na našem i engleskom jeziku bez potrebe za noćnim operaterom.",
    author: "Jelena Marković",
    role: "Voditeljica recepcije",
    metric: "< 1s vrijeme odgovora",
    badge: "Hoteli & Turizam",
    href: "/klijenti"
  },
  {
    quote: "Kao agencija, nudimo AI asistente svojim klijentima pod vlastitim brendom (whitelabel). Postavljanje je jednostavno, a klijenti su oduševljeni brzinom kojom njihovi kupci dobivaju odgovore.",
    author: "Nikola Božić",
    role: "Direktor digitalne agencije",
    metric: "15+ klijenata na platformi",
    badge: "Digitalne Agencije",
    href: "/klijenti"
  }
];
---

<section class="reveal-on-scroll w-full bg-[#fafafa]">
  <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x lg:border-b border-[#e4e4e7] lg:px-16 lg:py-20">
    <div class="text-center max-w-[640px] mx-auto">
      <h2 class="text-[1.85rem] font-medium leading-[1.18] tracking-[-0.025em] text-[#09090b] sm:text-[2.25rem] lg:text-[2.5rem]">
        Iskustva zadovoljnih klijenata
      </h2>
      <p class="mt-4 text-[16px] text-[#52525b]">
        Saznajte kako kompanije u regiji automatiziraju podršku i ostvaruju veći promet uz pitaj.io.
      </p>
    </div>

    <!-- Stories Grid -->
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {stories.map((story) => (
        <div class="flex flex-col justify-between rounded-2xl border border-[#e4e4e7] bg-white p-7 shadow-xs transition-all hover:shadow-md hover:border-[#d4d4d8]">
          <div>
            <div class="flex items-center justify-between">
              <span class="rounded-md border border-[#e4e4e7] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-[#09090b]">
                {story.badge}
              </span>
              <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 border border-emerald-200">
                {story.metric}
              </span>
            </div>

            <p class="mt-6 text-[16px] font-normal leading-relaxed text-[#27272a]">
              “{story.quote}”
            </p>
          </div>

          <div class="mt-8 flex items-center justify-between border-t border-[#e4e4e7] pt-4">
            <div>
              <div class="text-[14px] font-semibold text-[#09090b]">{story.author}</div>
              <div class="text-[12px] text-[#71717a]">{story.role}</div>
            </div>
            <a href={story.href} class="inline-flex items-center gap-1 text-[13px] font-medium text-[#09090b] hover:underline">
              Saznajte više
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 12l4-4-4-4"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
