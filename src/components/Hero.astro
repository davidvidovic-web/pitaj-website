---
import LiveWidgetShowcase from './LiveWidgetShowcase.astro';

const brandLogos = [
  { name: 'WooCommerce & WordPress', mono: '/chatbase-assets/thotis-mono.0nbsavymavuv4.svg', color: '/chatbase-assets/thotis.17cjlfyq7apcl.svg' },
  { name: 'Shopify Store', mono: '/chatbase-assets/aplazo-mono.1atbomff72tk2.svg', color: '/chatbase-assets/aplazo.0v5hbwqiyxe9o.svg' },
  { name: 'WhatsApp Business', mono: '/chatbase-assets/bridgestone-mono.1kp6_-h6pltmv.svg', color: '/chatbase-assets/bridgestone.2xfl9t2ekfci2.svg' },
  { name: 'Instagram & Meta', mono: '/chatbase-assets/opal-mono.3bq0yl41qkeyt.svg', color: '/chatbase-assets/opal.0gla976v21ueh.svg' },
  { name: 'Zendesk CRM', mono: '/chatbase-assets/dolby-mono.0jjlrc-3tqqmj.svg', color: '/chatbase-assets/dolby.07u0y3thqr9ha.svg' },
  { name: 'ERP & Cloud baze', mono: '/chatbase-assets/roche-mono.27ldfsorg4nvk.svg', color: '/chatbase-assets/roche.2hjc_h5_6_pch.svg' },
  { name: 'Pitaj Tiketi Helpdesk', mono: '/chatbase-assets/sage-mono.1zp8nnmnr-13q.svg', color: '/chatbase-assets/sage.127tkp_uokj61.svg' },
  { name: 'Dokumenti, PDF & Tablice', mono: '/chatbase-assets/pearson-mono.12ct-g1-6ect5.svg', color: '/chatbase-assets/pearson.0i5ekpihyezwi.svg' },
];
---

<section class="w-full bg-white overflow-visible">
  <div class="mx-auto max-w-[1240px] lg:border-x lg:border-b border-[#e4e4e7]">
    <!-- Hero Main Row -->
    <div class="relative overflow-hidden lg:flex">
      <!-- Left Column: Copy & CTAs -->
      <div class="relative flex flex-1 flex-col items-start justify-center px-6 pt-12 pb-10 text-left lg:min-h-[660px] lg:px-16 lg:py-16">
        <!-- Rating Badge -->
        <div class="animate-chip-rise flex items-center gap-2.5 rounded-full border border-[#e4e4e7] bg-[#fafafa] px-3.5 py-1.5 shadow-xs transition-all hover:bg-white hover:border-[#d4d4d8]">
          <div class="flex items-center text-amber-500">
            <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          </div>
          <span class="text-[13px] font-semibold text-[#09090b]">4.9</span>
          <span class="h-3.5 w-px bg-[#e4e4e7]" aria-hidden="true"></span>
          <span class="text-[13px] font-medium text-[#71717a]">Vodeća AI platforma za korisničku podršku i prodaju u regiji</span>
        </div>

        <!-- Headline -->
        <h1 class="mt-6 max-w-[560px] text-balance text-[2.5rem] font-medium leading-[1.08] tracking-[-0.035em] text-[#09090b] sm:text-[3.25rem] lg:text-[3.75rem]">
          Pametni AI <span class="font-proza font-bold italic">agenti</span> koji <span class="font-proza font-bold italic">poznaju</span> vaš biznis
        </h1>

        <!-- Subheading -->
        <p class="mt-5 max-w-[500px] text-[16px] leading-[1.5] text-[#52525b] sm:text-[18px]">
          Povežite web sajt, web trgovinu i dokumente. Pitaj.io agenti odgovaraju na upite kupaca 24/7 na webu, WhatsAppu i Instagramu, provjeravaju narudžbe i povećavaju prodaju.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center">
          <a
            href="/cijene"
            class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-white/20 bg-[image:linear-gradient(180deg,rgba(255,255,255,0)_0%,rgba(255,255,255,0.06)_100%)] bg-[#09090b] px-6 py-3.5 text-[15px] font-medium text-white shadow-[0_1px_2px_rgba(0,0,0,0.1),0_1px_3px_rgba(0,0,0,0.1)] transition-all duration-200 hover:bg-[#27272a] hover:shadow-md active:scale-[0.98]"
          >
            Isprobaj besplatno
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a
            href="/za-firme"
            class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-[#e4e4e7] bg-[image:linear-gradient(0deg,rgba(228,228,231,0)_50%,rgba(228,228,231,0.2)_100%)] bg-white px-6 py-3.5 text-[15px] font-medium text-[#09090b] shadow-[0_1px_2px_rgba(0,0,0,0.05)] transition-all duration-200 hover:bg-[#fafafa] hover:border-[#d4d4d8] active:scale-[0.98]"
          >
            Zakaži demo prezentaciju
          </a>
        </div>
      </div>

      <!-- Right Column: Hero Video Presentation (Widget hidden per request) -->
      <div class="relative aspect-[1056/1080] w-full overflow-hidden bg-[#0a0f1d] lg:aspect-auto lg:min-h-[660px] lg:w-[540px] lg:shrink-0 lg:border-l lg:border-[#e4e4e7]">
        <!-- Background poster image -->
        <img
          src="/chatbase-assets/hero-bg.098jdqowb0l1f.webp"
          alt=""
          aria-hidden="true"
          draggable="false"
          class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover"
        />

        <!-- Ambient Video particle / data sources layer -->
        <video
          src="https://backend.chatbase.co/storage/v1/object/public/chatbase/homepage/hero-data-sources.mp4"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"
          class="absolute inset-0 h-full w-full object-cover"
        >
          <source src="/chatbase-assets/hero-data-sources.mp4" type="video/mp4" />
          <source src="https://backend.chatbase.co/storage/v1/object/public/chatbase/homepage/hero-data-sources.mp4" type="video/mp4" />
        </video>
      </div>
    </div>

    <!-- Integrations Logos Bar (Desktop Grid with Mono/Color Hover + Mobile Marquee) -->
    <div class="border-t border-[#e4e4e7] bg-[#fafafa]/60 px-6 py-10 lg:px-16">
      <div class="text-center text-[12px] font-semibold uppercase tracking-wider text-[#a1a1aa] mb-6">
        Jednostavno se povezuje s vašim omiljenim alatima i platformama
      </div>

      <!-- Desktop 8-cell Grid with Chatbase Dual-layer Mono/Color transition -->
      <div class="hidden lg:grid lg:grid-cols-8 border border-[#e4e4e7] rounded-xl overflow-hidden bg-white shadow-2xs">
        {brandLogos.map((brand, idx) => (
          <div class={`group/cell relative flex h-20 items-center justify-center px-4 transition-colors duration-200 ease-out hover:bg-white ${idx !== brandLogos.length - 1 ? 'border-r border-[#e4e4e7]' : ''}`} title={brand.name}>
            <!-- Monochrome logo -->
            <img
              src={brand.mono}
              alt={brand.name}
              class="h-7 w-auto max-w-[100px] object-contain transition-opacity duration-200 ease-out group-hover/cell:opacity-0"
            />
            <!-- Color logo on hover -->
            <img
              src={brand.color}
              alt={brand.name}
              class="h-7 w-auto max-w-[100px] object-contain absolute inset-0 m-auto opacity-0 transition-opacity duration-200 ease-out group-hover/cell:opacity-100"
            />
          </div>
        ))}
      </div>

      <!-- Mobile & Tablet: Smooth infinite continuous Marquee -->
      <div class="block lg:hidden overflow-hidden border border-[#e4e4e7] rounded-xl bg-white py-3 shadow-2xs">
        <div class="animate-marquee flex items-center gap-8">
          {[...brandLogos, ...brandLogos].map((brand) => (
            <div class="flex items-center gap-2 shrink-0 px-2">
              <img src={brand.color} alt={brand.name} class="h-6 w-auto max-w-[90px] object-contain" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
