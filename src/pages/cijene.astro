        <!-- 5. Enterprise -->
        <div class="flex flex-col justify-between p-6 sm:p-7">
          <div>
            <!-- Header with icon -->
            <div class="flex items-center gap-2">
              <img src="/chatbase-assets/star-5.1bpp2-_6pa1l_.svg" alt="" class="h-4 w-4 shrink-0" />
              <span class="text-[14px] font-semibold text-[#09090b]">Enterprise</span>
            </div>

            <!-- Price -->
            <div class="mt-5">
              <div class="text-[36px] font-semibold tracking-tight text-[#09090b]">Dogovor</div>
              <div class="text-[12px] text-[#71717a]">prilagođeno vašem timu</div>
