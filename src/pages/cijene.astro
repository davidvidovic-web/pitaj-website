            </div>

            <div class="my-6 h-px w-full bg-[#f4f4f5]"></div>

            <div class="text-[12px] font-medium text-[#09090b] mb-3">Sve iz Starter +</div>

            <!-- Feature list -->
            <ul class="flex flex-col gap-3 text-[13px] text-[#52525b]">
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>4.000 poruka / mjesec</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>3 člana tima</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="underline decoration-dotted decoration-[#a1a1aa] underline-offset-2">Helpdesk & Tiketi</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="underline decoration-dotted decoration-[#a1a1aa] underline-offset-2">Glasovni agent (Voice AI)</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Integracija telefonije</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Odlazne automatske kampanje</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Puni REST API pristup</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="underline decoration-dotted decoration-[#a1a1aa] underline-offset-2">Personalizacija izgleda widgeta</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="underline decoration-dotted decoration-[#a1a1aa] underline-offset-2">Automatska resinhronizacija</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="underline decoration-dotted decoration-[#a1a1aa] underline-offset-2">Napredne integracije (WhatsApp, Stripe)</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- 4. Biznis (Pro) -->
        <div class="flex flex-col justify-between p-6 sm:p-7">
          <div>
            <!-- Header with icon -->
            <div class="flex items-center gap-2">
              <img src="/chatbase-assets/star-4.1s0440s2f4102.svg" alt="" class="h-4 w-4 shrink-0" />
              <span class="text-[14px] font-semibold text-[#09090b]">Biznis</span>
            </div>

            <!-- Price -->
