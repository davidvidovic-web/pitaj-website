<script>
  // Monthly / Yearly Billing Toggle Logic
  const btnMonthly = document.getElementById('btn-monthly');
  const btnYearly = document.getElementById('btn-yearly');
  
  const starterPrices = document.querySelectorAll('.price-val-starter');
  const standardPrices = document.querySelectorAll('.price-val-standard');
  const biznisPrices = document.querySelectorAll('.price-val-biznis');
  
  const tblMonthly = document.querySelector('.tbl-toggle-monthly');
  const tblYearly = document.querySelector('.tbl-toggle-yearly');

  function setBilling(isYearly: boolean) {
    if (isYearly) {
      btnMonthly?.classList.remove('bg-white', 'text-[#09090b]', 'shadow-xs');
      btnMonthly?.classList.add('text-[#71717a]');
      btnYearly?.classList.add('bg-white', 'text-[#09090b]', 'shadow-xs');
      btnYearly?.classList.remove('text-[#71717a]');

      starterPrices.forEach(el => el.textContent = '39 KM');
      standardPrices.forEach(el => el.textContent = '79 KM');
      biznisPrices.forEach(el => el.textContent = '159 KM');

      if (tblMonthly && tblYearly) {
        tblMonthly.classList.remove('bg-white', 'text-[#09090b]', 'shadow-xs', 'font-semibold');
        tblMonthly.classList.add('text-[#71717a]');
        tblYearly.classList.add('bg-white', 'text-[#09090b]', 'shadow-xs', 'font-semibold');
        tblYearly.classList.remove('text-[#71717a]');
      }
    } else {
      btnYearly?.classList.remove('bg-white', 'text-[#09090b]', 'shadow-xs');
      btnYearly?.classList.add('text-[#71717a]');
      btnMonthly?.classList.add('bg-white', 'text-[#09090b]', 'shadow-xs');
      btnMonthly?.classList.remove('text-[#71717a]');

      starterPrices.forEach(el => el.textContent = '49 KM');
      standardPrices.forEach(el => el.textContent = '99 KM');
      biznisPrices.forEach(el => el.textContent = '199 KM');

      if (tblMonthly && tblYearly) {
        tblYearly.classList.remove('bg-white', 'text-[#09090b]', 'shadow-xs', 'font-semibold');
        tblYearly.classList.add('text-[#71717a]');
        tblMonthly.classList.add('bg-white', 'text-[#09090b]', 'shadow-xs', 'font-semibold');
        tblMonthly.classList.remove('text-[#71717a]');
      }
    }
  }

  btnMonthly?.addEventListener('click', () => setBilling(false));
  btnYearly?.addEventListener('click', () => setBilling(true));
</script>
