---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Cijene i paketi - Pitaj.io"
  description="Predvidive cijene, skalabilni paketi. Započnite besplatno i prilagodite paket rastu vašeg poslovanja."
  currentPath="/cijene"
>
  <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 lg:border-x border-[#e4e4e7] lg:px-12 lg:py-20">
    
    <!-- Hero Header -->
    <div class="mx-auto max-w-[760px] text-center">
      <h1 class="text-balance text-[2.15rem] font-medium leading-[1.12] tracking-[-0.035em] text-[#09090b] sm:text-[3.25rem] lg:text-[4rem]">
        Predvidive cijene,<br />
        <span class="font-proza italic font-normal">skalabilni</span> paketi
      </h1>
      <p class="mt-4 text-[16px] text-[#71717a] sm:text-[19px]">
        Dizajnirano za svaku fazu vašeg rasta.
      </p>

      <!-- Monthly / Yearly Billing Toggle -->
      <div class="mt-8 inline-flex items-center rounded-full border border-[#e4e4e7] bg-[#f4f4f5]/60 p-1 shadow-xs">
        <button
          id="btn-monthly"
          type="button"
          class="rounded-full bg-white px-5 py-2 text-[13px] font-medium text-[#09090b] shadow-xs transition-all cursor-pointer"
        >
          Mjesečno
        </button>
        <button
          id="btn-yearly"
          type="button"
          class="rounded-full px-5 py-2 text-[13px] font-medium text-[#71717a] transition-all cursor-pointer hover:text-[#09090b]"
        >
          Godišnje
        </button>
      </div>

      <!-- 20% Discount Pill Tag -->
      <div class="mt-3.5 flex items-center justify-center gap-1.5 text-[13px] text-[#71717a]">
        <span class="flex h-4 w-4 items-center justify-center rounded-full bg-pink-100 text-pink-600">
          <svg class="h-2.5 w-2.5" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M2.5 6.5L4.5 8.5L9.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="font-medium text-[#09090b]">20% popusta</span>
        <span>na godišnje pakete</span>
      </div>
    </div>

    <!-- 5-Plan Horizontal Pricing Grid (Chatbase exact card layout) -->
    <div class="relative mt-16 pt-7">
      <!-- Container with outer rounded border and vertical dividers -->
      <div class="grid grid-cols-1 divide-y md:grid-cols-2 lg:grid-cols-5 md:divide-y-0 md:divide-x divide-[#e4e4e7] rounded-2xl border border-[#e4e4e7] bg-white shadow-xs">
        
        <!-- 1. Free / Besplatno -->
        <div class="flex flex-col justify-between p-6 sm:p-7">
          <div>
            <!-- Header with icon -->
            <div class="flex items-center gap-2">
              <img src="/chatbase-assets/star-1.0eb0elz5xqskb.svg" alt="" class="h-4 w-4 shrink-0" />
              <span class="text-[14px] font-semibold text-[#09090b]">Besplatno</span>
            </div>

            <!-- Price -->
            <div class="mt-5">
              <div class="text-[36px] font-semibold tracking-tight text-[#09090b]">0 KM</div>
              <div class="text-[12px] text-[#71717a]">mjesečno</div>
            </div>

            <!-- CTA Button -->
            <div class="mt-6">
              <a
                href="https://app.pitaj.io/auth/register"
                class="flex h-10 w-full items-center justify-center rounded-lg border border-[#e4e4e7] bg-white text-[13px] font-medium text-[#09090b] shadow-xs transition-colors hover:bg-[#fafafa]"
              >
                Započnite besplatno
              </a>
            </div>

            <div class="my-6 h-px w-full bg-[#f4f4f5]"></div>

            <!-- Feature list -->
            <ul class="flex flex-col gap-3 text-[13px] text-[#52525b]">
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="underline decoration-dotted decoration-[#a1a1aa] underline-offset-2">Pristup osnovnim modelima</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>50 poruka / mjesec</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>1 član tima</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 text-[11px] leading-relaxed text-[#a1a1aa]">
            AI agenti se automatski arhiviraju nakon 14 dana neaktivnosti na besplatnom planu.
          </div>
        </div>

        <!-- 2. Starter (Hobby) -->
        <div class="flex flex-col justify-between p-6 sm:p-7">
          <div>
            <!-- Header with icon -->
            <div class="flex items-center gap-2">
              <img src="/chatbase-assets/star-2.1gdmozr1d477f.svg" alt="" class="h-4 w-4 shrink-0" />
              <span class="text-[14px] font-semibold text-[#09090b]">Starter</span>
            </div>

            <!-- Price -->
            <div class="mt-5">
              <div class="flex items-baseline">
                <span class="price-val-starter text-[36px] font-semibold tracking-tight text-[#09090b]">49 KM</span>
              </div>
              <div class="text-[12px] text-[#71717a]">mjesečno</div>
            </div>

            <!-- CTA Button -->
            <div class="mt-6">
              <a
                href="https://app.pitaj.io/auth/register?plan=starter"
                class="flex h-10 w-full items-center justify-center rounded-lg border border-[#e4e4e7] bg-white text-[13px] font-medium text-[#09090b] shadow-xs transition-colors hover:bg-[#fafafa]"
              >
                7 dana besplatno
              </a>
            </div>

            <div class="my-6 h-px w-full bg-[#f4f4f5]"></div>

            <div class="text-[12px] font-medium text-[#09090b] mb-3">Sve iz Besplatno +</div>

            <!-- Feature list -->
            <ul class="flex flex-col gap-3 text-[13px] text-[#52525b]">
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="underline decoration-dotted decoration-[#a1a1aa] underline-offset-2">Pristup naprednim modelima</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>1.000 poruka / mjesec</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>2 člana tima</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="underline decoration-dotted decoration-[#a1a1aa] underline-offset-2">Integracije (Shopify, WP)</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Osnovna analitika</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Podrška za priloge i slike</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- 3. Standard [POPULAR] -->
        <div class="relative flex flex-col justify-between p-6 sm:p-7 bg-[#fafafa]/40">
          <!-- Popular Tab on Top of the Card -->
          <div class="absolute -top-3.5 sm:-top-7 left-1/2 -translate-x-1/2 flex justify-center pointer-events-none z-10">
            <span class="rounded-full sm:rounded-b-none sm:rounded-t-lg bg-black px-3.5 py-0.5 sm:py-1 text-[10px] sm:text-[11px] font-medium text-white tracking-wide shadow-xs whitespace-nowrap">
              Najpopularnije
