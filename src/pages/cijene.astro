                  <path d="M3 8.5L6.5 12L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="underline decoration-dotted decoration-[#a1a1aa] underline-offset-2">Napredna analitika & funnel</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-[#09090b] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
