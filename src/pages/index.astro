---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AgentShowcase from '../components/AgentShowcase.astro';
import AgentLifecycle from '../components/AgentLifecycle.astro';
import ProductSuite from '../components/ProductSuite.astro';
import DeployEverywhere from '../components/DeployEverywhere.astro';
import CustomerStories from '../components/CustomerStories.astro';
import EnterpriseSecurity from '../components/EnterpriseSecurity.astro';
import IndustryShowcase from '../components/IndustryShowcase.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout
  title="AI agenti za korisničku podršku i prodaju | pitaj.io"
  description="pitaj.io je vodeća regionalna platforma za AI agente. Automatizirajte odgovore na upite, provjeru narudžbi i prodaju na webu, WhatsAppu i društvenim mrežama."
  currentPath="/"
>
  <Hero />
  <AgentShowcase />
  <AgentLifecycle />
  <ProductSuite />
  <DeployEverywhere />
  <CustomerStories />
  <EnterpriseSecurity />
  <IndustryShowcase />
  <CtaBanner />
</Layout>
