---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import LiveWidgetShowcase from '../../components/LiveWidgetShowcase.astro';

const pillars = [
  {
    title: 'Više direktnih rezervacija bez posredničkih provizija',
    badge: 'Ušteda na provizijama',
    desc: 'Odgovorite gostu na upit o cijeni i pogodnostima u trenutku kada razmišlja o boravku i ponudite direktan link za rezervaciju na vašoj stranici umjesto na OTA platformama.'
  },
  {
    title: 'Tečni odgovori na više od 50 jezika',
    badge: 'Međunarodni gosti',
    desc: 'Agent komunicira jednako prirodno na engleskom, njemačkom, talijanskom, francuskom ili poljskom kao i na našem jeziku, bez potrebe za višejezičnim noćnim osobljem.'
  },
  {
    title: 'Check-in, parking i kućni red u svako doba',
    badge: 'Dostupnost 24/7',
    desc: 'Kasni dolasci, upute za parking, šifra za Wi-Fi, pravila o kućnim ljubimcima i radno vrijeme wellnessa — sve informacije dostupne trenutno.'
  },
  {
    title: 'Povezanost s WhatsAppom i emailom recepcije',
    badge: 'Omnichannel komunikacija',
    desc: 'Gosti vole komunicirati putem WhatsAppa tijekom boravka. Agent odgovara na upite o transferu, sobnoj usluzi i preporukama restorana.'
  }
];

const faqs = [
  {
    q: 'Može li se pitaj.io povezati s našim sustavom za rezervacije (PMS)?',
    a: 'Da. Kroz procedure i API integracije, agent može provjeriti raspoloživost soba, prikazati stvarne cijene za odabrane datume i preusmjeriti gosta u vaš booking engine.'
  },
  {
    q: 'Kako agent rješava specifične zahtjeve (npr. dječji krevetić ili rani check-in)?',
    a: 'Agent bilježi zahtjev gosta i automatski prosljeđuje tiket recepciji, ili odmah potvrđuje ako su pravila definirana u procedurama.'
  },
  {
    q: 'Može li agent slati automatske poruke gostima prije dolaska?',
    a: 'Da. Možete konfigurirati slanje poruka dobrodošlice, uputa za dolazak i lokacije na mapi putem WhatsAppa ili emaila.'
  },
  {
    q: 'Koliko traje postavljanje agenta za hotel ili apartmane?',
    a: 'Unosom linka vaše web stranice i kućnog reda u PDF formatu, osnovni agent je spreman za rad u manje od 15 minuta.'
  }
];
---

<Layout
  title="AI agenti za Hotele, Turizam i Smještaj - Pitaj.io"
  description="Povećajte direktne rezervacije i odgovarajte gostima 24/7 na više od 50 jezika. AI podrška za hotele, apartmane i turističke agencije."
  currentPath="/industrije/turizam"
>
  <!-- Hero Section with Background Industry Video -->
  <section class="relative w-full bg-slate-950 text-white overflow-hidden border-b border-[#27272a]">
    <video
      src="/chatbase-assets/industry-hospitality.mp4"
      muted
      loop
      autoplay
      playsinline
      preload="auto"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-35"
      style="transform: scale(1.05);"
    ></video>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"></div>

    <div class="relative z-10 mx-auto max-w-[1240px] px-6 py-20 lg:border-x border-[#27272a] lg:px-16 lg:py-28">
      <div class="max-w-[760px]">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-[12px] font-semibold uppercase tracking-wider text-amber-300 backdrop-blur-md">
          Hoteli, Turizam & Smještaj
        </div>
        <h1 class="mt-6 text-balance text-[2.5rem] font-medium leading-[1.08] tracking-[-0.035em] text-white sm:text-[3.25rem] lg:text-[3.75rem]">
          Direktne rezervacije i odgovori gostima <span class="font-proza font-bold italic">24 sata dnevno</span>
        </h1>
        <p class="mt-6 text-[17px] leading-relaxed text-slate-300 sm:text-[19px]">
          Gosti pitaju za slobodne sobe, parking, doručak i check-in u svako doba noći. Pitaj.io agenti odgovaraju tečno na njihovom jeziku, povezuju se s booking sustavom i pretvaraju posjetitelje u direktne goste.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="/cijene"
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-white px-7 text-[15px] font-semibold text-[#09090b] shadow-md transition-all hover:bg-slate-100"
          >
            Isprobajte za svoj objekt
          </a>
          <a
            href="/za-firme"
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-white/20 bg-black/40 px-7 text-[15px] font-medium text-white backdrop-blur-md hover:bg-white/10"
          >
            Zakažite prezentaciju
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Interactive Widget Simulation for Hospitality -->
  <section class="reveal-on-scroll w-full bg-[#fafafa] border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <span class="rounded-md border border-[#e4e4e7] bg-white px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-[#09090b]">
            Stvarni widget uživo
          </span>
          <h2 class="mt-4 text-[2.25rem] font-medium tracking-tight text-[#09090b]">
            Gost provjerava sobe i rezervira boravak <span class="font-proza font-bold italic">u samom chatu</span>
          </h2>
          <p class="mt-4 text-[16px] text-[#52525b] leading-relaxed">
            Isprobajte interaktivni demo desno: gost pita za vikend smještaj u Sarajevu, agent prikazuje karticu hotela sa slikom, cijenom noćenja u KM, ocjenom gostiju i sadržajima (Wi-Fi, bazen, parking), uz direktan odabir check-in i check-out termina.
          </p>

          <div class="mt-6 space-y-3">
            <div class="flex items-center gap-2.5 text-[14px] text-[#27272a]">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 text-[11px] font-bold">✓</span>
              <span>Povezano s booking i channel manager sustavom za točne termine</span>
            </div>
            <div class="flex items-center gap-2.5 text-[14px] text-[#27272a]">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 text-[11px] font-bold">✓</span>
              <span>Odgovaranje na više od 50 jezika bez jezičnih barijera</span>
            </div>
            <div class="flex items-center gap-2.5 text-[14px] text-[#27272a]">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 text-[11px] font-bold">✓</span>
              <span>Direktne uplate bez plaćanja 15–25% provizije posrednicima</span>
            </div>
          </div>
        </div>

        <div class="w-full">
          <LiveWidgetShowcase initialTab="hotel" theme="dark" />
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Core Pillars -->
  <section class="reveal-on-scroll w-full bg-white border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="text-center max-w-[700px] mx-auto">
        <h2 class="text-[2rem] font-medium tracking-tight text-[#09090b]">
          Treniran na vašim cijenama, kućnom redu i ponudi objekta
        </h2>
        <p class="mt-3 text-[16px] text-[#52525b]">
          Pružite gostima osjećaj vrhunske recepcijske usluge prije, tijekom i nakon boravka.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {pillars.map((p) => (
          <div class="flex flex-col justify-between rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-7 shadow-xs transition-all hover:border-[#d4d4d8] hover:shadow-md">
            <div>
              <span class="rounded-md border border-[#e4e4e7] bg-white px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-[#09090b]">
                {p.badge}
              </span>
              <h3 class="mt-4 text-[19px] font-semibold text-[#09090b]">{p.title}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="reveal-on-scroll w-full bg-[#fafafa] border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="max-w-[700px] mx-auto">
        <h2 class="text-center text-[2rem] font-medium tracking-tight text-[#09090b]">
          Česta pitanja za hotele i iznajmljivače
        </h2>

        <div class="mt-10 space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-xl border border-[#e4e4e7] bg-white p-6 shadow-xs">
              <h3 class="text-[16px] font-semibold text-[#09090b]">{faq.q}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
