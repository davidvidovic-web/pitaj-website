---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const pillars = [
  {
    title: 'Strogo pridržavanje službenih cjenika i pravila',
    badge: 'Nulta improvizacija',
    desc: 'Agent se strogo drži vaše dokumentacije i procedura. Ne daje neutemeljene dijagnoze niti proizvoljne savjete, već upućuje pacijenta na pregled.'
  },
  {
    title: 'Rasterećenje telefonskih linija i osoblja',
    badge: 'Ušteda vremena',
    desc: 'Preko 70% rutinskih upita ("Koliko košta pregled?", "Trebam li doći natašte?", "Kako se pripremiti?") rješava se automatski 24/7.'
  },
  {
    title: 'Anonimizacija i GDPR zaštita osjetljivih podataka',
    badge: 'Zaštita privatnosti',
    desc: 'Automatsko prepoznavanje i maskiranje osobnih podataka prije obrade, uz poslužitelje unutar EU (Frankfurt) i potpisivanje DPA ugovora.'
  },
  {
    title: 'Rezervacija termina s provjerom rasporeda',
    badge: 'Povezanost s kalendarom',
    desc: 'Pacijent ili klijent može samostalno odabrati slobodni termin prema rasporedu ordinacije, uz automatsku potvrdu putem WhatsAppa ili SMS-a.'
  }
];

const faqs = [
  {
    q: 'Hoće li agent davati medicinske savjete ili dijagnoze?',
    a: 'Ne. Kroz sistemske upute agent je jasno instruiran da ne postavlja dijagnoze, već isključivo pruža informacije o uslugama, cijenama, pripremi za zahvate i slobodnim terminima.'
  },
  {
    q: 'Kako je osigurana privatnost medicinskih podataka pacijenata?',
    a: 'Svi podaci obrađuju se na EU serverima, a promet je zaštićen TLS 1.3 enkripcijom. Podaci pacijenata se nikada ne koriste za treniranje javnih AI modela.'
  },
  {
    q: 'Može li se agent integrirati s našim medicinskim softverom ili kalendarom?',
    a: 'Da. Kroz API integracije i webhooks sustave, agent može dohvatiti slobodne termine iz vašeg softvera i unijeti rezervaciju izravno u raspored.'
  },
  {
    q: 'Što ako pacijent opiše hitan slučaj?',
    a: 'Procedura za hitne slučajeve odmah prepoznaje ključne riječi (npr. "jaki bolovi", "hitno") te prikazuje broj hitne pomoći ili dežurnog liječnika.'
  }
];
---

<Layout
  title="AI agenti za Poliklinike, Zdravstvo i Usluge | pitaj.io"
  description="AI agent treniran na vašim pravilima, cjenicima i propisima o privatnosti. Sigurno rukovanje osjetljivim podacima, zakazivanje termina i rasterećenje osoblja."
  currentPath="/industrije/zdravstvo-i-usluge"
>
  <!-- Hero Section with Background Industry Video -->
  <section class="relative w-full bg-slate-950 text-white overflow-hidden border-b border-[#27272a]">
    <video
      src="/chatbase-assets/industry-financial-services.mp4"
      muted
      loop
      autoplay
      playsinline
      preload="auto"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-35"
      style="transform: scale(1.05);"
    ></video>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"></div>

    <div class="relative z-10 mx-auto max-w-[1240px] px-6 py-20 lg:border-x border-[#27272a] lg:px-16 lg:py-28">
      <div class="max-w-[760px]">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-[12px] font-semibold uppercase tracking-wider text-sky-300 backdrop-blur-md">
          Poliklinike, Zdravstvo & Usluge
        </div>
        <h1 class="mt-6 text-balance text-[2.5rem] font-medium leading-[1.08] tracking-[-0.035em] text-white sm:text-[3.25rem] lg:text-[3.75rem]">
          Pouzdanost, sigurnost i <span class="font-proza font-bold italic">odgovori po pravilima</span>
        </h1>
        <p class="mt-6 text-[17px] leading-relaxed text-slate-300 sm:text-[19px]">
          Pacijenti traže točne informacije o cijenama, pripremi za preglede i slobodnim terminima. Pitaj.io agenti odgovaraju prema strogim protokolima bez improvizacije, uz potpunu GDPR usklađenost.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="/cijene"
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-white px-7 text-[15px] font-semibold text-[#09090b] shadow-md transition-all hover:bg-slate-100"
          >
            Isprobajte za polikliniku
          </a>
          <a
            href="/za-firme"
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-white/20 bg-black/40 px-7 text-[15px] font-medium text-white backdrop-blur-md hover:bg-white/10"
          >
            Zakažite prezentaciju
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Core Pillars -->
  <section class="reveal-on-scroll w-full bg-white border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="text-center max-w-[700px] mx-auto">
        <h2 class="text-[2rem] font-medium tracking-tight text-[#09090b]">
          Treniran na vašim protokolima, uslugama i uvjetima
        </h2>
        <p class="mt-3 text-[16px] text-[#52525b]">
          Sigurnost pacijenta i točnost informacija su na prvom mjestu.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {pillars.map((p) => (
          <div class="flex flex-col justify-between rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-7 shadow-xs transition-all hover:border-[#d4d4d8] hover:shadow-md">
            <div>
              <span class="rounded-md border border-[#e4e4e7] bg-white px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-[#09090b]">
                {p.badge}
              </span>
              <h3 class="mt-4 text-[19px] font-semibold text-[#09090b]">{p.title}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="reveal-on-scroll w-full bg-[#fafafa] border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="max-w-[700px] mx-auto">
        <h2 class="text-center text-[2rem] font-medium tracking-tight text-[#09090b]">
          Česta pitanja za poliklinike i ordinacije
        </h2>

        <div class="mt-10 space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-xl border border-[#e4e4e7] bg-white p-6 shadow-xs">
              <h3 class="text-[16px] font-semibold text-[#09090b]">{faq.q}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
