---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const faqs = [
  {
    q: 'Što točno Backstage zapravo čita?',
    a: 'Backstage čita i analizira sve transkripte razgovora s vaših kanala (web widget, WhatsApp, Instagram, Messenger), uključujući pitanja kupaca, odgovore agenta, preglede proizvoda i reakcije posjetitelja.'
  },
  {
    q: 'Moram li sam bilo što konfigurirati ili pripremiti?',
    a: 'Ne. Nema postavljanja složenih filtera, baza podataka ili SQL upita. Backstage automatski indeksira sve razgovore čim agent počne raditi i trenutačno je spreman za upite na običnom jeziku.'
  },
  {
    q: 'Kako postavljam pitanja?',
    a: 'Pitanja postavljate na običnom jeziku, baš onako kako biste pitali kolegu ili voditelja korisničkog iskustva — npr. "Što kupci najčešće pitaju prije kupovine?" ili "Zašto su se zahtjevi za povrat povećali ovog tjedna?".'
  },
  {
    q: 'Mogu li vidjeti iz kojih razgovora je proizašao odgovor?',
    a: 'Da, svaki sažetak i uvid sadrži izravne poveznice na stvarne transkripte razgovora, tako da uvijek možete provjeriti kontekst, vremenske oznake i točne riječi kupaca.'
  },
  {
    q: 'Mijenja li agenta samostalno bez moje dozvole?',
    a: 'Nikada. Backstage otkriva obrasce i priprema točan nacrt izmjene (novu instrukciju, bazu znanja ili proceduru), ali promjena se ne objavljuje dok je vi ručno ne pregledate i ne odobrite.'
  },
  {
    q: 'Je li predložena izmjena testirana prije nego što je vidim?',
    a: 'Da. Prije nego što vam ponudi prijedlog, Backstage automatski pokreće simulacijske testove na vašim arhiviranim razgovorima i spremljenim scenarijima kako bi potvrdio da novi odgovor ne narušava postojeća pravila.'
  },
  {
    q: 'Što ako odobrena izmjena pogorša odgovore?',
    a: 'Sve promjene imaju zabilježenu povijest verzija. Jednim klikom na opciju "Roll it back" možete trenutno poništiti bilo koju izmjenu i sigurno vratiti prethodnu verziju postavki.'
  }
];

const askCards = [
  {
    title: 'Pitajte na običnom jeziku',
    text: '“Što kupci najviše pitaju ovaj tjedan?” “Zašto su se zahtjevi za povrat udvostručili?” “Što kupci kažu neposredno prije nego odustanu?” Pitajte ga onako kako biste pitali kolegu.',
    icon: 'chat'
  },
  {
    title: 'Uzorci kroz sve razgovore, a ne uzorak',
    text: 'Čita apsolutno sve. Teme kroz tisuće razgovora grupirane tako da ih odmah vidite, umjesto onoga što se slučajno pojavilo u zadnjih dvadeset pregledanih tiketa.',
    icon: 'network'
  },
  {
    title: 'Što se mijenja u trendovima',
    text: 'Nova pitanja koja se javljaju, stara koja nestaju, porast pritužbi u jednoj regiji ili na jednom proizvodu. Promjene koje biste inače primijetili tek mjesec dana prekasno.',
    icon: 'cycle'
  },
  {
    title: 'Pronađite izvorni razgovor',
    text: 'Svaki odgovor vodi izravno do razgovora koji stoje iza njega. Pročitajte stvarne dijaloge umjesto da slijepo vjerujete pukom broju na grafikonu.',
    icon: 'route'
  },
  {
    title: 'Više od same podrške',
    text: 'Većina onoga što vam kupci kažu nije problem za podršku, već povratna informacija o proizvodu koju nitko nije zapisao. Backstage je izvlači na vidjelo za cijeli tim.',
    icon: 'lightning'
  }
];

const capabilities = [
  {
    title: 'Pronalazi rupe u znanju',
    desc: 'Pitanja na koja vaši izvori nemaju odgovor, popisana zajedno s pripremljenim nacrtom sadržaja koji nedostaje.',
    icon: 'search-doc'
  },
  {
    title: 'Predlaže točne izmjene',
    desc: 'Ne "stopa rješavanja je pala 4 boda", već točna instrukcija i pravilo koje treba precizirati.',
    icon: 'edit-chat'
  },
  {
    title: 'Testirano prije nego što vam se predloži',
    desc: 'Svaka izmjena se automatski testira na vašim spremljenim scenarijima, tako da prijedlog stiže s dokazom točnosti.',
    icon: 'beaker'
  },
  {
    title: 'Odobrite, uredite ili odbijte',
    desc: 'Prihvatite kako je napisano, prvo prilagodite tekst ili odbijte. Odbijanjem agent također uči vaša pravila.',
    icon: 'checklist'
  },
  {
    title: 'Potpuna povijest izmjena',
    desc: 'Što se promijenilo, kada, tko je odobrio izmjenu i kakav je bio rezultat na razgovore nakon toga.',
    icon: 'history'
  },
  {
    title: 'Vraćanje jednim klikom',
    desc: 'Ako izmjena nije donijela očekivani rezultat, jednostavno je poništite i trenutno vratite prethodnu verziju.',
    icon: 'rollback'
  }
];
---

<Layout
  title="Backstage analitika i učenje - Pitaj.io"
  description="Na sceni služi vašim kupcima, Backstage radi za vas: postavite pitanje vlastitoj arhivi razgovora na običnom jeziku i saznajte što kupci žele."
  currentPath="/mogucnosti/analitika"
>
  <!-- 1. Hero Section -->
  <section class="w-full bg-[#fafafa]">
    <div class="mx-auto max-w-[1240px] lg:border-x border-[#e4e4e7]">
      <!-- Header Copy -->
      <div class="px-6 pt-16 pb-12 lg:px-20 lg:pt-24 lg:pb-16 text-center">
        <div class="max-w-[860px] mx-auto">
          <h1 class="text-balance text-[2.75rem] font-medium leading-[1.08] tracking-[-0.035em] text-[#09090b] sm:text-[3.5rem] lg:text-[4rem]">
            Na sceni služi vašim kupcima,<br />
            Backstage <span class="font-proza font-bold italic">radi za vas</span>
          </h1>
          <p class="mt-6 text-[17px] leading-relaxed text-[#52525b] sm:text-[19px] max-w-[720px] mx-auto">
            Isti agent, okrenut prema vašem menadžmentu. Data analitičar koji već poznaje vaše poslovanje i svaki razgovor koji je vodio, te kreator agenta koji piše rješenja. Vi odobravate ono što ide uživo.
          </p>

          <!-- CTA Buttons -->
          <div class="mt-9 flex flex-col items-center justify-center gap-3.5 sm:flex-row">
            <a
              href="https://app.pitaj.io/auth/register"
              class="flex h-11 w-full sm:w-auto items-center justify-center rounded-full bg-[#09090b] px-7 text-[14px] font-medium text-white shadow-sm transition-all hover:bg-[#27272a] active:scale-[0.98]"
            >
              Kreirajte agenta
            </a>
            <a
              href="/za-firme"
              class="flex h-11 w-full sm:w-auto items-center justify-center rounded-full border border-[#e4e4e7] bg-white px-7 text-[14px] font-medium text-[#09090b] shadow-xs transition-all hover:bg-[#fafafa] active:scale-[0.98]"
            >
              Zakažite demo
            </a>
          </div>
        </div>
      </div>

      <!-- Hero Orange Container with Authentic Backstage Interface Mockup (Full-width of 1240px container) -->
      <div class="w-full border-y border-[#e4e4e7] overflow-hidden bg-gradient-to-br from-[#ff5420] via-[#ea580c] to-[#c2410c] shadow-inner">
        <img
          src="/chatbase-assets/backstage-hero-mockup.webp"
          alt="Backstage radna površina i analitika razgovora"
          class="w-full h-auto object-cover block"
          loading="eager"
        />
      </div>

      <!-- Trusted by 10,000+ businesses bar -->
      <div class="px-6 py-16 lg:px-20 text-center">
        <div class="text-[13px] font-medium tracking-wide text-[#71717a]">
          Preko 10.000+ kompanija ima povjerenje u našu tehnologiju
        </div>

        <!-- 3x5 Authentic Client Logos Grid -->
        <div class="mt-7 max-w-[1080px] mx-auto overflow-hidden rounded-xl border border-[#e4e4e7] bg-white shadow-2xs">
          <img
            src="/chatbase-assets/backstage-logo-grid.webp"
            alt="Dolby, EF, Opal, Miele, Firecrawl, Thotis, Aplazo, SIAE, Slovenia, Bridgestone, Chuck E. Cheese, Nikon, Jumia, Roche, Brevo"
            class="w-full h-auto object-contain block"
          />
        </div>

        <!-- G2 Star Rating -->
        <div class="mt-6 flex items-center justify-center gap-2 text-[14px] font-semibold text-[#09090b]">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#f43f5e] text-white text-[11px] font-bold">G</span>
          <div class="flex items-center text-amber-400 gap-0.5">
            <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
          <span>4.8</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Diamond Lattice Row Divider -->
  <div class="w-full bg-[#fafafa]">
    <div class="mx-auto max-w-[1240px] lg:border-x border-[#e4e4e7]">
      <div class="border-t border-[#e4e4e7]">
        <svg aria-hidden="true" width="100%" height="24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-6 w-full text-[#e4e4e7]">
          <title>Diamond row divider</title>
          <defs>
            <pattern id="backstage-diamond-divider" width="23.3725" height="24" patternUnits="userSpaceOnUse">
              <path d="M11.6863 1.0208 L22.6655 12 L11.6863 22.9792 L0.7071 12 Z" stroke="currentColor"></path>
            </pattern>
          </defs>
          <rect width="100%" height="24" fill="url(#backstage-diamond-divider)"></rect>
        </svg>
      </div>
    </div>
  </div>

  <!-- Central Connector Diamond Node -->
  <div class="relative w-full bg-[#fafafa]">
    <div class="mx-auto max-w-[1240px] lg:border-x border-[#e4e4e7]">
      <div class="relative flex items-center justify-center py-6">
        <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-[#e4e4e7]"></div>
        <div class="relative z-10 flex flex-col items-center">
          <div class="w-px h-3 bg-[#e4e4e7]"></div>
          <div class="h-4 w-4 bg-white border border-[#e4e4e7] rotate-45 shadow-2xs"></div>
          <div class="w-px h-3 bg-[#e4e4e7]"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. Section: It knows your business, and your customers too -->
  <section class="reveal-on-scroll w-full bg-[#fafafa]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-20 lg:py-20">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Left: Royal Blue Card with Conversation Mockup -->
        <div class="overflow-hidden rounded-2xl border border-[#e4e4e7] bg-[#1d4ed8] shadow-md">
          <img
            src="/chatbase-assets/backstage-sec1-card.webp"
            alt="Pregled razgovora i generiranje odgovora"
            class="w-full h-auto object-cover block"
          />
        </div>

        <!-- Right: Text Content -->
        <div>
          <h2 class="text-balance text-[2.25rem] font-medium leading-[1.12] tracking-[-0.03em] text-[#09090b] sm:text-[2.75rem]">
            Poznaje vaše poslovanje, ali i vaše kupce
          </h2>
          <p class="mt-5 text-[17px] leading-relaxed text-[#52525b]">
            Već poznaje vaše proizvode, politike poslovanja i povezane sustave, jer to je vaš agent. I razgovarao je s vašim kupcima cijeli dan, za razliku od bilo kojeg drugog analitičkog alata.
          </p>
        </div>
      </div>

      <!-- 3 Columns Below -->
      <div class="mt-16 grid grid-cols-1 gap-8 border-t border-[#e4e4e7] pt-10 md:grid-cols-3">
        <!-- Col 1 -->
        <div class="flex flex-col">
          <div class="flex items-center gap-2.5 text-[#2563eb]">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
            <h3 class="text-[15px] font-semibold text-[#09090b]">Vaš kontekst, već učitan</h3>
          </div>
          <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">
            Vaši izvori, vaše procedure, vaši povezani sustavi. Nitko ne mora objašnjavati što je vaš proizvod ili kako funkcionira povrat novca prije nego što postavite pitanje.
          </p>
        </div>

        <!-- Col 2 -->
        <div class="flex flex-col border-t border-[#e4e4e7] pt-6 md:border-t-0 md:border-l md:pl-8 md:pt-0">
          <div class="flex items-center gap-2.5 text-[#2563eb]">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="m4.93 4.93 4.24 4.24"/>
              <path d="m14.83 9.17 4.24-4.24"/>
              <path d="m14.83 14.83 4.24 4.24"/>
              <path d="m9.17 14.83-4.24 4.24"/>
              <circle cx="12" cy="12" r="4"/>
            </svg>
            <h3 class="text-[15px] font-semibold text-[#09090b]">Bez ikakvog podešavanja</h3>
          </div>
          <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">
            Svaki razgovor koji je obradio, kroz sve kanale. Ne uzorak koji je netko izvezao u Excel, niti dvadeset tiketa koji su slučajno pregledani ovaj tjedan.
          </p>
        </div>

        <!-- Col 3 -->
        <div class="flex flex-col border-t border-[#e4e4e7] pt-6 md:border-t-0 md:border-l md:pl-8 md:pt-0">
          <div class="flex items-center gap-2.5 text-[#2563eb]">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
              <line x1="3" x2="21" y1="9" y2="9"/>
              <line x1="9" x2="9" y1="21" y2="9"/>
            </svg>
            <h3 class="text-[15px] font-semibold text-[#09090b]">Radi na vašoj infrastrukturi</h3>
          </div>
          <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">
            Spojite to dvoje i dobit ćete više od pukog izvještaja: točno ono što kupci stalno pitaju i koja instrukcija, izvor ili korak bi im odgovorio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Central Connector Diamond Node -->
  <div class="relative w-full bg-[#fafafa]">
    <div class="mx-auto max-w-[1240px] lg:border-x border-[#e4e4e7]">
      <div class="relative flex items-center justify-center py-6">
        <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-[#e4e4e7]"></div>
        <div class="relative z-10 flex flex-col items-center">
          <div class="w-px h-3 bg-[#e4e4e7]"></div>
          <div class="h-4 w-4 bg-white border border-[#e4e4e7] rotate-45 shadow-2xs"></div>
          <div class="w-px h-3 bg-[#e4e4e7]"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Section: Ask it anything about your customers -->
  <section class="reveal-on-scroll w-full bg-[#fafafa]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-20 lg:py-20">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Left: Heading -->
        <div class="lg:sticky lg:top-28 self-start">
          <h2 class="text-balance text-[2.25rem] font-medium leading-[1.12] tracking-[-0.03em] text-[#09090b] sm:text-[2.75rem]">
            Pitajte ga bilo što<br />o svojim kupcima
          </h2>
          <p class="mt-5 text-[17px] leading-relaxed text-[#52525b]">
            Nije unaprijed zadana nadzorna ploča s odgovorima koje je netko drugi odabrao za vas. Postavite pitanje koje vas uistinu zanima, na običnom jeziku, i dobit ćete odgovor izvučen iz svakog razgovora.
          </p>
        </div>

        <!-- Right: Stack of 5 White Feature Cards -->
        <div class="flex flex-col gap-4">
          {askCards.map((card) => (
            <div class="rounded-xl border border-[#e4e4e7] bg-white p-6 shadow-xs transition-all hover:border-[#d4d4d8] hover:shadow-sm">
              <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-pink-50 text-[#b0067e]">
                  {card.icon === 'chat' && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  )}
                  {card.icon === 'network' && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 8-4-4-4 4"/><path d="M14 4v12a2 2 0 0 1-2 2H4"/><circle cx="4" cy="18" r="2"/><circle cx="18" cy="8" r="2"/></svg>
                  )}
                  {card.icon === 'cycle' && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
                  )}
                  {card.icon === 'route' && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/></svg>
                  )}
                  {card.icon === 'lightning' && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                  )}
                </div>
                <h3 class="text-[16px] font-semibold text-[#09090b]">{card.title}</h3>
              </div>
              <p class="mt-3 text-[14px] leading-relaxed text-[#52525b] pl-11">
                {card.text}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Central Connector Diamond Node -->
