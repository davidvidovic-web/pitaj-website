        <div class="flex items-start gap-3.5 border-t border-[#27272a] pt-6 md:border-t-0 md:border-l md:pl-8 md:pt-0">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-orange-500/10 text-orange-500">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <div>
            <h4 class="text-[15px] font-semibold text-white">Enkripcija podataka</h4>
            <p class="mt-1.5 text-[13px] leading-relaxed text-[#a1a1aa]">
              Podaci su kriptirani u mirovanju i u prijenosu korištenjem suvremenih TLS 1.3 i AES-256 standarda.
            </p>
          </div>
        </div>

        <!-- Pillar 3 -->
        <div class="flex items-start gap-3.5 border-t border-[#27272a] pt-6 md:border-t-0 md:border-l md:pl-8 md:pt-0">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-orange-500/10 text-orange-500">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <h4 class="text-[15px] font-semibold text-white">Sigurne integracije</h4>
            <p class="mt-1.5 text-[13px] leading-relaxed text-[#a1a1aa]">
              Koristimo verificirane varijable i izolirane tokove podataka kako bismo osigurali da korisnici pristupaju samo svojim podacima.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Central Connector Diamond Node -->
  <div class="relative w-full bg-[#fafafa]">
    <div class="mx-auto max-w-[1240px] lg:border-x border-[#e4e4e7]">
      <div class="relative flex items-center justify-center py-6">
        <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-[#e4e4e7]"></div>
        <div class="relative z-10 flex flex-col items-center">
          <div class="w-px h-3 bg-[#e4e4e7]"></div>
          <div class="h-4 w-4 bg-white border border-[#e4e4e7] rotate-45 shadow-2xs"></div>
          <div class="w-px h-3 bg-[#e4e4e7]"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 8. Section: Frequently asked questions -->
  <section class="reveal-on-scroll w-full bg-[#fafafa]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-20 lg:py-20">
      <div class="max-w-[760px] mx-auto">
        <h2 class="text-center text-balance text-[2.25rem] font-medium leading-[1.12] tracking-[-0.03em] text-[#09090b] sm:text-[2.75rem]">
          Česta pitanja
        </h2>

        <!-- Accordion Rows -->
        <div class="mt-12 divide-y divide-[#e4e4e7] border-y border-[#e4e4e7]">
          {faqs.map((faq) => (
            <details class="group py-5 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 text-left font-medium text-[#09090b] transition-colors hover:text-[#2563eb]">
                <span class="text-[16px] sm:text-[17px] font-semibold">{faq.q}</span>
                <span class="relative flex h-6 w-6 shrink-0 items-center justify-center text-[#71717a] transition-transform duration-200 group-open:rotate-45">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
              </summary>
              <p class="mt-3 pr-8 text-[14px] leading-relaxed text-[#52525b]">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Central Connector Diamond Node -->
  <div class="relative w-full bg-[#fafafa]">
    <div class="mx-auto max-w-[1240px] lg:border-x border-[#e4e4e7]">
      <div class="relative flex items-center justify-center py-6">
        <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-[#e4e4e7]"></div>
        <div class="relative z-10 flex flex-col items-center">
          <div class="w-px h-3 bg-[#e4e4e7]"></div>
          <div class="h-4 w-4 bg-white border border-[#e4e4e7] rotate-45 shadow-2xs"></div>
          <div class="w-px h-3 bg-[#e4e4e7]"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 9. Section: Explore other features -->
  <section class="reveal-on-scroll w-full bg-white">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-20 lg:py-20 text-center">
      <div class="max-w-[700px] mx-auto">
        <h2 class="text-balance text-[2.25rem] font-medium leading-[1.12] tracking-[-0.03em] text-[#09090b] sm:text-[2.75rem]">
          Istražite ostale mogućnosti
        </h2>
        <p class="mt-4 text-[16px] leading-relaxed text-[#52525b]">
          Jedan agent kroz cijelu platformu. Isto znanje, isti ton brenda, gdje god se razgovor odvijao.
        </p>
      </div>

      <!-- 3 Feature Navigation Cards -->
      <div class="mt-12 grid grid-cols-1 gap-6 text-left sm:grid-cols-3">
        <!-- Procedures -->
        <a
          href="/mogucnosti/procedure"
          class="group flex flex-col justify-between rounded-2xl border border-[#e4e4e7] bg-white p-7 shadow-xs transition-all hover:border-[#d4d4d8] hover:shadow-md"
        >
          <div>
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange-50 text-orange-600">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
              </svg>
            </div>
            <div class="mt-6 flex items-center gap-1.5 text-[17px] font-semibold text-[#09090b] group-hover:text-[#2563eb] transition-colors">
              <span>Procedure</span>
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </div>
            <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">
              Trenirajte agenta na isti način kako trenirate svoj tim.
            </p>
          </div>
        </a>

        <!-- Helpdesk -->
        <a
          href="/mogucnosti/helpdesk"
          class="group flex flex-col justify-between rounded-2xl border border-[#e4e4e7] bg-white p-7 shadow-xs transition-all hover:border-[#d4d4d8] hover:shadow-md"
        >
          <div>
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="18" height="18" x="3" y="3" rx="2"/>
                <path d="M3 9h18"/>
                <path d="M9 21V9"/>
              </svg>
            </div>
            <div class="mt-6 flex items-center gap-1.5 text-[17px] font-semibold text-[#09090b] group-hover:text-[#2563eb] transition-colors">
              <span>Helpdesk</span>
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </div>
            <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">
              Prijenos na čovjeka s punim razgovorom i svime što je agent već napravio.
            </p>
          </div>
        </a>

        <!-- Product Overview -->
        <a
          href="/mogucnosti"
          class="group flex flex-col justify-between rounded-2xl border border-[#e4e4e7] bg-white p-7 shadow-xs transition-all hover:border-[#d4d4d8] hover:shadow-md"
        >
          <div>
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                <polyline points="2 17 12 22 22 17"/>
                <polyline points="2 12 12 17 22 12"/>
              </svg>
            </div>
            <div class="mt-6 flex items-center gap-1.5 text-[17px] font-semibold text-[#09090b] group-hover:text-[#2563eb] transition-colors">
              <span>Pregled platforme</span>
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </div>
            <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">
              Izgradite, testirajte, postavite i poboljšajte agenta, sve na jednom mjestu.
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Central Connector Diamond Node -->
  <div class="relative w-full bg-[#fafafa]">
    <div class="mx-auto max-w-[1240px] lg:border-x border-[#e4e4e7]">
      <div class="relative flex items-center justify-center py-6">
        <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-[#e4e4e7]"></div>
        <div class="relative z-10 flex flex-col items-center">
          <div class="w-px h-3 bg-[#e4e4e7]"></div>
          <div class="h-4 w-4 bg-white border border-[#e4e4e7] rotate-45 shadow-2xs"></div>
          <div class="w-px h-3 bg-[#e4e4e7]"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 10. Bottom CTA Banner -->
  <CtaBanner />
</Layout>
