---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const pillars = [
  {
    title: 'Dva načina prijenosa na čovjeka',
    badge: 'Pametno usmjeravanje',
    desc: 'Automatski prijenos kada se prepozna složeni problem ili nezadovoljstvo kupca, ili trenutno na eksplicitni zahtjev posjetitelja ("Želim razgovarati s čovjekom").',
    icon: '⇄'
  },
  {
    title: 'AI Ko-pilot za vaše operatere',
    badge: 'Produktivnost tima',
    desc: 'Operater ne mora pisati odgovor od nule. AI u sekundi priprema točan nacrt odgovora na temelju baze znanja, a operater ga može odobriti ili prilagoditi jednim klikom.',
    icon: '⚡'
  },
  {
    title: 'Objedinjeni višekanalni inbox',
    badge: 'Sve na jednom mjestu',
    desc: 'Sve poruke s web chata, WhatsAppa, Instagrama i emaila stižu u jedno jedinstveno sučelje s kompletnom poviješću prethodnih kupovina i razgovora.',
    icon: '📬'
  },
  {
    title: 'Povežite postojeći Helpdesk ili CRM',
    badge: 'Fleksibilna integracija',
    desc: 'Koristite naš ugrađeni sustav Pitaj Tiketi, ili povežite vanjske alate poput Zendeska, Freshdeska ili slanja obavijesti direktno na Slack ili email.',
    icon: '⚙'
  }
];

const faqs = [
  {
    q: 'Kako operater zna kada se treba uključiti u razgovor?',
    a: 'Kada dođe do eskalacije, operater dobiva zvučnu obavijest, obavijest na desktopu ili u mobilnoj aplikaciji. AI agent u međuvremenu kupca ljubazno obavijesti da se spaja operater.'
  },
  {
    q: 'Što se događa ako su operateri izvan radnog vremena?',
    a: 'Ako nijedan operater nije dostupan, agent automatski prikuplja kontakt podatke (email i telefon), kreira tiket s prioritetom i obećava odgovor ujutro.'
  },
  {
    q: 'Vidi li operater što je kupac ranije razgovarao s AI agentom?',
    a: 'Da. Operater u trenutku preuzimanja vidi cijeli transkript razgovora, sve provjere narudžbi koje je agent već izvršio i AI sažetak problema u 2 rečenice.'
  },
  {
    q: 'Mogu li ograničiti pristup podacima po članovima tima?',
    a: 'Da. Podržane su granularne uloge: Administrator, Voditelj podrške i Operater, s točno definiranim pravima pristupa klijentskim razgovorima.'
  }
];
---

<Layout
  title="Tiketi & AI Helpdesk | pitaj.io"
  description="Objedinjeni AI helpdesk sustav za upravljanje tiketima, odgovaranje korisnicima uživo, automatski prijenos na operatere i AI ko-pilot."
  currentPath="/mogucnosti/helpdesk"
>
  <!-- Hero Section -->
  <section class="w-full bg-white border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-24">
      <div class="max-w-[800px] mx-auto text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#e4e4e7] bg-[#fafafa] px-3.5 py-1.5 text-[12px] font-semibold uppercase tracking-wider text-[#09090b]">
          Objedinjeni Helpdesk
        </div>
        <h1 class="mt-6 text-balance text-[2.5rem] font-medium leading-[1.08] tracking-[-0.035em] text-[#09090b] sm:text-[3.25rem] lg:text-[3.75rem]">
          Besprijekoran prijenos na operatera, uz <span class="font-proza font-bold italic">puni kontekst</span>
        </h1>
        <p class="mt-6 text-[17px] leading-relaxed text-[#52525b] sm:text-[19px]">
          Kada upit zahtijeva ljudsku empatiju, popust ili odobrenje, pitaj.io preusmjerava razgovor pravom timu bez gubitka konteksta — uz predloženi AI odgovor koji operater odobrava u sekundi.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/cijene"
            class="inline-flex h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-lg bg-[#09090b] px-7 text-[15px] font-medium text-white shadow-sm transition-all hover:bg-[#27272a]"
          >
            Isprobajte Helpdesk
          </a>
          <a
            href="/za-firme"
            class="inline-flex h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-lg border border-[#e4e4e7] bg-white px-7 text-[15px] font-medium text-[#09090b] shadow-xs transition-all hover:bg-[#fafafa]"
          >
            Zakažite prezentaciju
          </a>
        </div>
      </div>

      <!-- Hero Helpdesk Simulator -->
      <div class="mt-16 rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-6 lg:p-10 shadow-sm">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          <!-- Sidebar: Ticket list -->
          <div class="rounded-xl border border-[#e4e4e7] bg-white p-4 shadow-2xs space-y-3">
            <div class="flex items-center justify-between border-b border-[#e4e4e7] pb-3">
              <span class="text-[13px] font-semibold text-[#09090b]">Ulazni tiketi</span>
              <span class="rounded bg-blue-50 px-2 py-0.5 text-[11px] font-bold text-blue-700">3 Nova</span>
            </div>

            <!-- Active Ticket Item -->
            <div class="rounded-lg border-2 border-[#09090b] bg-[#fafafa] p-3 text-left">
              <div class="flex items-center justify-between text-[12px]">
                <span class="font-bold text-[#09090b]">Maja Vasić</span>
                <span class="text-[11px] text-[#71717a]">Prije 2m</span>
              </div>
              <div class="mt-1 text-[13px] font-medium text-[#09090b] truncate">Veleprodajna narudžba i popust</div>
              <div class="mt-2 flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                <span class="text-[11px] font-semibold text-amber-700">Čeka operatera</span>
              </div>
            </div>

            <!-- Ticket Item 2 -->
            <div class="rounded-lg border border-[#e4e4e7] bg-white p-3 text-left opacity-75">
              <div class="flex items-center justify-between text-[12px]">
                <span class="font-medium text-[#09090b]">Mirko Savić</span>
                <span class="text-[11px] text-[#71717a]">Prije 14m</span>
              </div>
              <div class="mt-1 text-[13px] text-[#52525b] truncate">Povrat patika veličina 44</div>
              <div class="mt-2 flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                <span class="text-[11px] text-emerald-700">Riješio AI agent</span>
              </div>
            </div>

            <!-- Ticket Item 3 -->
            <div class="rounded-lg border border-[#e4e4e7] bg-white p-3 text-left opacity-75">
              <div class="flex items-center justify-between text-[12px]">
                <span class="font-medium text-[#09090b]">Jasmina B.</span>
                <span class="text-[11px] text-[#71717a]">Prije 45m</span>
              </div>
              <div class="mt-1 text-[13px] text-[#52525b] truncate">Upit za rezervaciju termina</div>
              <div class="mt-2 flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                <span class="text-[11px] text-emerald-700">Riješio AI agent</span>
              </div>
            </div>
          </div>

          <!-- Main Area: Chat & Co-Pilot -->
          <div class="lg:col-span-2 rounded-xl border border-[#e4e4e7] bg-white p-6 shadow-2xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between border-b border-[#e4e4e7] pb-4">
                <div>
                  <div class="text-[15px] font-semibold text-[#09090b]">Maja Vasić • WhatsApp</div>
                  <div class="text-[12px] text-[#71717a]">Kupac iz Banja Luke • Ukupno 4 narudžbe</div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="rounded bg-emerald-50 px-2.5 py-1 text-[11px] font-bold text-emerald-700 border border-emerald-200">Preuzeto</span>
                  <button type="button" class="rounded-md border border-[#e4e4e7] px-3 py-1 text-[12px] text-[#52525b] hover:bg-[#fafafa]">
                    Zatvori tiket
                  </button>
                </div>
              </div>

              <!-- Message History -->
              <div class="mt-5 space-y-3">
                <div class="rounded-lg bg-[#f4f4f5] p-3 text-[13px] text-[#27272a] max-w-[85%]">
                  <div class="text-[11px] font-bold text-[#71717a] mb-1">Maja (Kupac)</div>
                  "Pozdrav! Želim naručiti 25 komada vaših radnih stolica za naš novi ured. Imate li poseban popust i koji je rok isporuke?"
                </div>
                <div class="rounded-lg bg-emerald-50/70 border border-emerald-200 p-3 text-[13px] text-emerald-950 max-w-[85%]">
                  <div class="text-[11px] font-bold text-emerald-700 mb-1">Pitaj AI Asistent</div>
                  "Pozdrav Maja! Za narudžbe iznad 20 komada odobravamo 15% popusta. Odmah ću vas povezati s kolegom iz odjela prodaje kako bismo vam pripremili ponudu."
                </div>
              </div>

              <!-- AI Co-Pilot Suggestion Box -->
              <div class="mt-6 rounded-xl border border-blue-200 bg-blue-50/60 p-4">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2 text-[12px] font-bold text-blue-900">
                    <span class="h-2 w-2 rounded-full bg-blue-600 animate-ping"></span>
                    AI Predloženi odgovor za Maju:
                  </div>
                  <span class="text-[11px] text-blue-700 font-medium">Ušteda: ~3 min kucanja</span>
                </div>
                <p class="text-[13px] text-blue-950 leading-relaxed">
                  "Poštovana Maja, Marko ovdje iz prodaje. Za 25 stolica odobravamo vam 15% rabata uz besplatnu dostavu direktno na vašu adresu u roku od 48 sati. Možete li mi navesti naziv firme za izdavanje predračuna?"
                </p>
                <div class="mt-3 flex items-center justify-end gap-2">
                  <button type="button" class="rounded-md border border-blue-300 bg-white px-3 py-1.5 text-[12px] font-medium text-blue-900 hover:bg-blue-50">
                    Uredi tekst
                  </button>
                  <button type="button" class="rounded-md bg-[#09090b] px-4 py-1.5 text-[12px] font-medium text-white hover:bg-[#27272a] shadow-xs">
                    Odobri i pošalji (1 klik)
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Pillars Section -->
  <section class="reveal-on-scroll w-full bg-white border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="text-center max-w-[700px] mx-auto">
        <h2 class="text-[2rem] font-medium tracking-tight text-[#09090b]">
          Sve što je vašem timu potrebno za brzu podršku
        </h2>
        <p class="mt-3 text-[16px] text-[#52525b]">
          Automatizirajte rutinu, a ljudima prepustite razgovore koji grade dugoročne odnose.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {pillars.map((p) => (
          <div class="flex flex-col justify-between rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-7 shadow-xs transition-all hover:border-[#d4d4d8] hover:shadow-md">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-md border border-[#e4e4e7] bg-white px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-[#09090b]">
                  {p.badge}
                </span>
                <span class="text-[18px]">{p.icon}</span>
              </div>
              <h3 class="mt-4 text-[19px] font-semibold text-[#09090b]">{p.title}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="reveal-on-scroll w-full bg-[#fafafa] border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="max-w-[700px] mx-auto">
        <h2 class="text-center text-[2rem] font-medium tracking-tight text-[#09090b]">
          Česta pitanja o Helpdesku
        </h2>

        <div class="mt-10 space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-xl border border-[#e4e4e7] bg-white p-6 shadow-xs">
              <h3 class="text-[16px] font-semibold text-[#09090b]">{faq.q}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Explore Other Features Navigation -->
  <section class="w-full bg-white border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-[20px] font-semibold text-[#09090b]">Istražite ostale mogućnosti platforme</h2>
        <a href="/mogucnosti" class="text-[14px] font-medium text-[#09090b] hover:underline">Pregled svih alata →</a>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        <a href="/mogucnosti/widgeti" class="group block rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-6 transition-all hover:border-[#d4d4d8] hover:shadow-md">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#71717a]">Sučelja</div>
          <h3 class="mt-2 text-[17px] font-semibold text-[#09090b] group-hover:underline">Interaktivni widgeti</h3>
          <p class="mt-1 text-[13px] text-[#52525b]">Prikaz kartica proizvoda, mapa za praćenje i kalendara.</p>
        </a>
        <a href="/mogucnosti/procedure" class="group block rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-6 transition-all hover:border-[#d4d4d8] hover:shadow-md">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#71717a]">Pravila</div>
          <h3 class="mt-2 text-[17px] font-semibold text-[#09090b] group-hover:underline">Procedure</h3>
          <p class="mt-1 text-[13px] text-[#52525b]">Definirajte poslovna pravila i logiku običnim jezikom.</p>
        </a>
        <a href="/mogucnosti/analitika" class="group block rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-6 transition-all hover:border-[#d4d4d8] hover:shadow-md">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#71717a]">Analitika</div>
          <h3 class="mt-2 text-[17px] font-semibold text-[#09090b] group-hover:underline">Backstage učenje</h3>
          <p class="mt-1 text-[13px] text-[#52525b]">Otkrijte rupe u bazi znanja i poboljšajte odgovore agenta.</p>
        </a>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
