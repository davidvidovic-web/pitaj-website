---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const templates = [
  {
    name: 'Povrat ili zamjena robe',
    trigger: 'Kupac pita za zamjenu veličine ili povrat novca',
    steps: 'Provjera datuma dostave (< 14 dana) → Kreiranje kurirskog naloga → Slanje potvrde',
    badge: 'E-Commerce'
  },
  {
    name: 'Provjera statusa pošiljke',
    trigger: 'Kupac pita "Gdje je moj paket?" ili unese broj narudžbe',
    steps: 'Dohvat broja narudžbe → API provjera kod kurirske službe → Prikaz widgeta s mapom',
    badge: 'Logistika'
  },
  {
    name: 'Zakazivanje pregleda ili termina',
    trigger: 'Kupac traži slobodan termin za tretman ili pregled',
    steps: 'Provjera slobodnih termina u kalendaru → Odabir satnice → Zapisivanje pacijenta i SMS potvrda',
    badge: 'Klinike & Saloni'
  },
  {
    name: 'Kvalifikacija B2B leadova',
    trigger: 'Upit za ponudu, količinski rabat ili partnerstvo',
    steps: 'Prikupljanje naziva firme i broja zaposlenih → Provjera budžeta → Prijenos na voditelja prodaje',
    badge: 'B2B & Agencije'
  }
];

const faqs = [
  {
    q: 'Što je točno procedura u pitaj.io?',
    a: 'Procedura je strukturirani radni tok (SOP) napisan u običnom jeziku. Ona govori agentu točan redoslijed koraka: koje podatke mora zatražiti od kupca, koji API mora pozvati i što napraviti u slučaju različitih ishoda.'
  },
  {
    q: 'Moram li pisati programski kod ili crtati složene dijagrame toka?',
    a: 'Ne. Nema povlačenja strelica niti programiranja. Pravila definirate običnim rečenicama, npr: "Prvo zatraži broj narudžbe. Ako je narudžba starija od 14 dana, objasni politiku povrata. U suprotnom, ponudi zamjenu."'
  },
  {
    q: 'Kako agent zna kada treba pokrenuti proceduru?',
    a: 'Agent analizira kontekst razgovora. Kada korisnik izrazi namjeru koja odgovara okidaču (triggeru) procedure, agent neprimjetno preuzima definirane korake i vodi korisnika do cilja.'
  },
  {
    q: 'Što se događa kada kupac skrene s teme usred procedure?',
    a: 'Za razliku od starih chatbota koji se "zaglave", pitaj.io agent razumije pauzu. Odgovori na usputno pitanje kupca, a zatim se prirodno vrati na dovršetak prethodno započetog koraka.'
  },
  {
    q: 'Mogu li testirati proceduru prije puštanja u rad?',
    a: 'Da. Ugrađeni Sandbox simulator omogućuje vam da isprobate proceduru, simulirate krive unose, prekidate agenta i pregledate točan trag izvršenih koraka (trace) prije nego što postane vidljiva kupcima.'
  }
];
---

<Layout
  title="Procedure i poslovna pravila | pitaj.io"
  description="Trenirajte agenta kao novog člana tima: definirajte procedure u običnom jeziku, postavite uvjete, API akcije i provjere bez programiranja."
  currentPath="/mogucnosti/procedure"
>
  <!-- Hero Section -->
  <section class="w-full bg-white border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-24">
      <div class="max-w-[820px] mx-auto text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#e4e4e7] bg-[#fafafa] px-3.5 py-1.5 text-[12px] font-semibold uppercase tracking-wider text-[#09090b]">
          Poslovna logika & SOP
        </div>
        <h1 class="mt-6 text-balance text-[2.5rem] font-medium leading-[1.08] tracking-[-0.035em] text-[#09090b] sm:text-[3.25rem] lg:text-[3.75rem]">
          Trenirajte agenta kao novog <span class="font-proza font-bold italic">člana tima</span>
        </h1>
        <p class="mt-6 text-[17px] leading-relaxed text-[#52525b] sm:text-[19px]">
          Razlika između pukog odgovaranja i stvarnog izvršavanja zadataka. Napišite svoja pravila običnim jezikom — agent sustavno prati svaki korak, provjerava uvjete i poziva API servise bez greške.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/cijene"
            class="inline-flex h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-lg bg-[#09090b] px-7 text-[15px] font-medium text-white shadow-sm transition-all hover:bg-[#27272a]"
          >
            Isprobajte procedure
          </a>
          <a
            href="/za-firme"
            class="inline-flex h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-lg border border-[#e4e4e7] bg-white px-7 text-[15px] font-medium text-[#09090b] shadow-xs transition-all hover:bg-[#fafafa]"
          >
            Zakažite prezentaciju
          </a>
        </div>
      </div>

      <!-- Hero Procedure Visual Code & Logic Preview -->
      <div class="mt-16 rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-6 lg:p-12 shadow-sm">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-center">
          <!-- Left: Value Prop -->
          <div>
            <span class="rounded-md border border-[#e4e4e7] bg-white px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-[#09090b]">
              Determinističko izvršavanje
            </span>
            <h2 class="mt-4 text-[24px] font-semibold text-[#09090b]">Pisano kao tekst, pokreće se kao logika</h2>
            <p class="mt-3 text-[15px] text-[#52525b] leading-relaxed">
              Agenti za podršku često griješe kada se oslanjaju samo na općeniti prompt. Uz procedure, vi definirate točan scenarij: što pitati, koje uvjete provjeriti i kada pozvati vanjski API sustav.
            </p>

            <div class="mt-6 space-y-3">
              <div class="flex items-start gap-3">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-800 text-[12px] font-bold">1</div>
                <div class="text-[14px] text-[#27272a]"><strong class="font-semibold text-[#09090b]">Stroge granice:</strong> Agent nikada ne izmišlja popuste ili obećanja izvan definiranih pravila.</div>
              </div>
              <div class="flex items-start gap-3">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-100 text-blue-800 text-[12px] font-bold">2</div>
                <div class="text-[14px] text-[#27272a]"><strong class="font-semibold text-[#09090b]">Povezanost s bazama:</strong> Čitanje i ažuriranje statusa u WooCommerce, Shopify ili internom ERP-u.</div>
              </div>
              <div class="flex items-start gap-3">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-purple-100 text-purple-800 text-[12px] font-bold">3</div>
                <div class="text-[14px] text-[#27272a]"><strong class="font-semibold text-[#09090b]">Jednostavno testiranje:</strong> Provjerite ponašanje agenta u simulatoru prije objave.</div>
              </div>
            </div>
          </div>

          <!-- Right: Interactive Logic Mockup -->
          <div class="rounded-xl border border-[#e4e4e7] bg-[#09090b] text-white p-6 shadow-xl overflow-hidden font-mono text-[12px]">
            <div class="flex items-center justify-between border-b border-white/15 pb-3">
              <span class="text-slate-400">zamjena_artikla_procedura.yaml</span>
              <span class="rounded bg-emerald-500/20 px-2 py-0.5 text-[10px] text-emerald-400 font-bold">Aktivno pravilo</span>
            </div>

            <pre class="mt-4 text-emerald-400 leading-relaxed overflow-x-auto"><code><span class="text-slate-500"># Definicija radnog toka u običnom jeziku</span>
<span class="text-purple-400">naziv:</span> zamjena_velicine_proizvoda
<span class="text-purple-400">okidac:</span> kupac zeli zamijeniti proizvod ili velicinu
<span class="text-purple-400">koraci:</span>
  - <span class="text-amber-300">pitaj:</span> "Koji je broj vaše narudžbe i željena nova veličina?"
  - <span class="text-blue-300">akcija:</span> pozovi_api(woocommerce.provjera, &#123;narudzba, velicina&#125;)
  - <span class="text-rose-300">uvjet:</span> ako je na_stanju == true
      <span class="text-emerald-300">onda:</span>
        - rezerviraj_artikal()
        - kreiraj_nalog_brza_posta()
        - posalji_potvrdu_kupcu()
      <span class="text-amber-300">inace:</span>
        - ponudi_povrat_novca_ili_drugi_model()</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ready to Use Templates Section -->
  <section class="reveal-on-scroll w-full bg-white border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="text-center max-w-[700px] mx-auto">
        <h2 class="text-[2rem] font-medium tracking-tight text-[#09090b]">
          Gotovi predlošci procedura, spremni za prilagodbu
        </h2>
        <p class="mt-3 text-[16px] text-[#52525b]">
          Nemojte kretati od nule. Iskoristite provjerene procedure prilagođene regionalnom poslovanju.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {templates.map((tpl) => (
          <div class="flex flex-col justify-between rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-7 shadow-xs transition-all hover:border-[#d4d4d8] hover:shadow-md">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-md border border-[#e4e4e7] bg-white px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-[#09090b]">
                  {tpl.badge}
                </span>
                <span class="text-[11px] text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded font-medium border border-emerald-200">
                  Uključeno u paket
                </span>
              </div>
              <h3 class="mt-4 text-[19px] font-semibold text-[#09090b]">{tpl.name}</h3>
              <div class="mt-2 text-[13px] text-[#27272a]"><strong class="font-medium text-[#71717a]">Okidač:</strong> {tpl.trigger}</div>
              <div class="mt-2 text-[13px] text-[#52525b]"><strong class="font-medium text-[#71717a]">Koraci:</strong> {tpl.steps}</div>
            </div>
            <div class="mt-6 pt-4 border-t border-[#e4e4e7] flex items-center justify-between">
              <span class="text-[12px] text-[#71717a]">100% prilagodljivo</span>
              <a href="/cijene" class="text-[12px] font-semibold text-[#09090b] hover:underline">Isprobaj predložak →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="reveal-on-scroll w-full bg-[#fafafa] border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="max-w-[700px] mx-auto">
        <h2 class="text-center text-[2rem] font-medium tracking-tight text-[#09090b]">
          Česta pitanja o procedurama
        </h2>

        <div class="mt-10 space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-xl border border-[#e4e4e7] bg-white p-6 shadow-xs">
              <h3 class="text-[16px] font-semibold text-[#09090b]">{faq.q}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Explore Other Features Navigation -->
  <section class="w-full bg-white border-b border-[#e4e4e7]">
    <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-[20px] font-semibold text-[#09090b]">Istražite ostale mogućnosti platforme</h2>
        <a href="/mogucnosti" class="text-[14px] font-medium text-[#09090b] hover:underline">Pregled svih alata →</a>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        <a href="/mogucnosti/widgeti" class="group block rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-6 transition-all hover:border-[#d4d4d8] hover:shadow-md">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#71717a]">Sučelja</div>
          <h3 class="mt-2 text-[17px] font-semibold text-[#09090b] group-hover:underline">Interaktivni widgeti</h3>
          <p class="mt-1 text-[13px] text-[#52525b]">Prikaz kartica proizvoda, mapa za praćenje i kalendara.</p>
        </a>
        <a href="/mogucnosti/helpdesk" class="group block rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-6 transition-all hover:border-[#d4d4d8] hover:shadow-md">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#71717a]">Timski rad</div>
          <h3 class="mt-2 text-[17px] font-semibold text-[#09090b] group-hover:underline">Tiketi & Helpdesk</h3>
          <p class="mt-1 text-[13px] text-[#52525b]">Objedinjeni inbox i AI ko-pilot za vaše ljudske operatere.</p>
        </a>
        <a href="/mogucnosti/analitika" class="group block rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-6 transition-all hover:border-[#d4d4d8] hover:shadow-md">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-[#71717a]">Analitika</div>
          <h3 class="mt-2 text-[17px] font-semibold text-[#09090b] group-hover:underline">Backstage učenje</h3>
          <p class="mt-1 text-[13px] text-[#52525b]">Otkrijte rupe u bazi znanja i poboljšajte odgovore agenta.</p>
        </a>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
